{
  "name": "Sovereign Desk - 1-Click Dispatch Transport Executor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dispatch-application",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-dispatch",
      "name": "Webhook - 1-Click Dispatch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "sovereign-dispatch-executor"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://host.docker.internal:3000' + ($json.body.pdfUrl || '/output/resume.pdf') }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "resume_pdf"
            }
          }
        }
      },
      "id": "node-fetch-pdf",
      "name": "Fetch Typst PDF Artifact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = $('Webhook - 1-Click Dispatch').first().json.body || {};\n\nconst candidate = {\n  firstName: 'Alex',\n  lastName: 'Vance',\n  email: 'alex.vance@systems-core.io',\n  phone: '+1 (415) 890-4321',\n  location: 'San Francisco, CA (Remote Only)',\n  linkedin: 'https://linkedin.com/in/alex-vance-dist',\n  github: 'https://github.com/alex-vance',\n  website: 'https://systems-core.io',\n  applicationId: body.applicationId || 'app-unknown',\n  receiptId: body.receiptId || ('DISP-' + Math.random().toString(36).substring(2, 8).toUpperCase()),\n  company: body.company || 'Target',\n  role: body.role || 'Staff Systems Engineer',\n  transport: body.transport || 'Greenhouse API',\n  pdfUrl: body.pdfUrl || '/output/resume.pdf',\n  timestamp: body.timestamp || new Date().toISOString()\n};\n\nreturn [{\n  json: candidate,\n  binary: item.binary\n}];"
      },
      "id": "node-enrich-candidate",
      "name": "Enrich Candidate Dossier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.transport }}",
        "rules": {
          "rules": [
            {
              "value2": "Greenhouse",
              "operation": "contains"
            },
            {
              "value2": "Ashby",
              "operation": "contains",
              "output": 1
            },
            {
              "value2": "Lever",
              "operation": "contains",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 3
      },
      "id": "node-switch-transport",
      "name": "Route Transport (Greenhouse / Ashby / Lever)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://boards-api.greenhouse.io/v1/boards/' + $json.company.toLowerCase().replace(/[^a-z0-9]/g, '') + '/jobs/' + $json.applicationId }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "first_name",
              "value": "={{ $json.firstName }}"
            },
            {
              "name": "last_name",
              "value": "={{ $json.lastName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "notes",
              "value": "={{ 'Autonomous 1-Click Airgap Dispatch via Sovereign Desk. Audit Receipt: ' + $json.receiptId }}"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "resume_pdf:resume",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "node-dispatch-greenhouse",
      "name": "Greenhouse Multipart Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.ashbyhq.com/posting-api/job-board/' + $json.company.toLowerCase().replace(/[^a-z0-9]/g, '') + '/application' }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $json.firstName + ' ' + $json.lastName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "notes",
              "value": "={{ 'Autonomous 1-Click Airgap Dispatch via Sovereign Desk. Audit Receipt: ' + $json.receiptId }}"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "resume_pdf:resume",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "node-dispatch-ashby",
      "name": "Ashby Multipart Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.lever.co/v0/postings/' + $json.company.toLowerCase().replace(/[^a-z0-9]/g, '') + '/' + $json.applicationId }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $json.firstName + ' ' + $json.lastName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "comments",
              "value": "={{ 'Autonomous 1-Click Airgap Dispatch via Sovereign Desk. Audit Receipt: ' + $json.receiptId }}"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "resume_pdf:resume",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "node-dispatch-lever",
      "name": "Lever Multipart Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 440]
    },
    {
      "parameters": {
        "jsCode": "const candidate = $('Enrich Candidate Dossier').first().json;\nconst responseData = $input.first().json;\n\nreturn [{\n  json: {\n    applicationId: candidate.applicationId,\n    receiptId: candidate.receiptId,\n    company: candidate.company,\n    transport: candidate.transport,\n    status: 'DISPATCH_CONFIRMED',\n    httpStatus: responseData.statusCode || 200,\n    dispatchedAt: new Date().toISOString(),\n    auditSummary: 'Outbound multipart dispatch executed for ' + candidate.company + ' via ' + candidate.transport,\n    auditDetail: 'Payload verified with binary Typst PDF resume attachment (' + candidate.pdfUrl + '). Receipt ' + candidate.receiptId + '.'\n  }\n}];"
      },
      "id": "node-format-audit",
      "name": "Format Dispatch Audit Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/timeline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ applicationId: $json.applicationId, eventType: 'DISPATCH_CONFIRMED', summary: $json.auditSummary, detail: $json.auditDetail }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-audit-timeline",
      "name": "Audit Log to Desk Timeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300]
    }
  ],
